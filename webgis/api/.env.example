# API do WebGIS (#171). Copie para .env e preencha. NUNCA commitar o .env.
WEBGIS_DATABASE_URL=postgresql://webgis:webgis@localhost:5433/webgis
WEBGIS_INTERNAL_KEY=troque-por-um-segredo-longo     # o mesmo no .env do Pasto Legal
WEBGIS_HMAC_KEY=troque-por-outro-segredo-longo      # só a API conhece
WEBGIS_PUBLIC_URL=http://localhost:4200             # o link vai como {url}/#t={token}
WEBGIS_CORS_ORIGINS=http://localhost:4200
PASTO_LEGAL_EVENTS_URL=                             # vazio = sem aviso no WhatsApp (não proativo)
WEBGIS_LINK_OPEN_MINUTES=5
WEBGIS_IDLE_FINISH_MINUTES=10
WEBGIS_RETENTION_DAYS=30
WEBGIS_MAX_PADDOCKS=200
